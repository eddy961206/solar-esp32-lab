# Vercel 배포: 프레임워크가 자동 감지하는 설정 파일.
# - 빌드 명령/출력 디렉터리는 Vercel이 Next.js를 보고 자동 설정합니다.
# - 여기서는 보안 헤더 + 캐싱만 담당합니다 (민감 정보 없음).
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
